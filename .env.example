SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

RESEND_API_KEY=
ALERT_EMAIL_FROM=LaBaJo & Co <alertes@votre-domaine.fr>
ALERT_EMAIL_TO=florent.lambert@gmail.com

# ==========================================================================================
# DIVIDENDES (PEA / compte-titres) — clés STRICTEMENT serveur, jamais NEXT_PUBLIC_
# ==========================================================================================
# Alpha Vantage est la source gratuite principale des dividendes ANNONCÉS : c'est le seul
# fournisseur gratuit qui publie à la fois la date de détachement ET la date de paiement.
#
# Obtenir la clé (gratuit, ~20 secondes, sans carte bancaire) :
#   1. ouvrir https://www.alphavantage.co/support/#api-key
#   2. saisir un e-mail et le type d'usage, valider
#   3. la clé s'affiche immédiatement ; la coller ci-dessous, puis redémarrer `npm run dev`
# Limite du forfait gratuit : environ 25 appels par jour. L'application les décompte elle-même
# (table market_data_requests) et étale la synchronisation sur plusieurs jours si nécessaire.
ALPHA_VANTAGE_API_KEY=
# Plafond quotidien appliqué côté application. À ajuster si le forfait change.
ALPHA_VANTAGE_DAILY_LIMIT=25

# Ordre des fournisseurs de dividendes. Un fournisseur non configuré est simplement ignoré :
# l'application ne le confond jamais avec une panne.
DIVIDEND_PRIMARY_PROVIDER=alpha_vantage
DIVIDEND_SECONDARY_PROVIDER=eodhd
# Secours technique. Yahoo ne publie ni date de paiement ni annonce future : il n'alimente que
# l'historique, base des projections. Il exige aussi ENABLE_EXPERIMENTAL_YAHOO_PROVIDER=true.
DIVIDEND_FALLBACK_PROVIDER=yahoo
# Secours personnel français : uniquement des fiches DividLand explicitement associées à un ISIN.
# Aucun ETF/fonds ni recherche par nom. La limite est volontairement très basse (4 appels/jour).
DIVIDEND_FRANCE_FALLBACK_PROVIDER=dividland
DIVIDENDS_DIVIDLAND_ENABLED=true

# Projections internes (échéances non encore annoncées). Sur `false`, l'écran n'affiche que le
# reçu et l'annoncé — utile pour vérifier ce qui est réellement confirmé.
ENABLE_DIVIDEND_PROJECTIONS=true
# Durée de validité du cache : un instrument synchronisé depuis moins longtemps n'est pas
# réinterrogé, ce qui protège le quota.
DIVIDEND_CACHE_TTL_HOURS=24

# Optionnel : recherche de symboles héritée dans /api/admin/market (même clé qu'Alpha Vantage).
# Marché PEA / compte-titres — exclusivement côté serveur, jamais NEXT_PUBLIC_. EODHD est
# limité à 20 appels/jour dans le forfait gratuit : l'application applique un cache Supabase.
EODHD_API_TOKEN=
MARKET_DATA_PRIMARY_PROVIDER=eodhd
# Yahoo est le secours serveur. Ses endpoints sont publics, sans clé et sans SLA :
# il ne sera jamais appelé côté navigateur. Si le drapeau de sécurité reste à false,
# la route retourne explicitement `fallback_disabled` pour chaque actif concerné.
MARKET_DATA_FALLBACK_PROVIDER=yahoo
ENABLE_EXPERIMENTAL_YAHOO_PROVIDER=true
# Optionnel : scan IA de relevés (PDF/image) pour l'import d'opérations.
# La clé reste STRICTEMENT serveur (jamais de préfixe NEXT_PUBLIC_). Sans ces variables, le scan
# IA est simplement désactivé ; l'import CSV/XLSX et la saisie manuelle restent disponibles.
ANTHROPIC_API_KEY=
# ou OPENAI_API_KEY=
# DOCUMENT_AI_PROVIDER=anthropic   # anthropic | openai | none (auto-détecté selon la clé présente)
# DOCUMENT_AI_MODEL=claude-sonnet-5
# DOCUMENT_AI_MAX_PAGES=15
# DOCUMENT_AI_MAX_FILE_SIZE_MB=10
# DOCUMENT_AI_HIGH_CONFIDENCE=85   # seuil (%) confiance « élevée »
# DOCUMENT_AI_LOW_CONFIDENCE=60    # sous ce seuil (%), ligne bloquée par défaut
# DOCUMENT_AI_PASSES=3             # relectures indépendantes votant cellule par cellule (1 à 5).
#                                  # Elles partent EN PARALLÈLE : 3 passes ≈ le temps d'une seule.
#                                  # Mesuré : une passe unique se trompe sur ~6 cellules chiffrées
#                                  # sur 30 en annonçant 90-98 % de confiance ; le vote fait
#                                  # remonter ces cellules au lieu de les valider en silence.
# DOCUMENT_AI_REASONING_EFFORT=minimal   # minimal | low | medium | high (série gpt-5).
#                                  # Mesuré : « high » = 92 s et 10 880 jetons de raisonnement
#                                  # pour AUTANT d'erreurs de lecture que « minimal » à 16 s.
#                                  # Retranscrire un tableau est de la perception, pas du calcul.
# DOCUMENT_AI_TIMEOUT_MS=120000    # 60 s était trop court : une passe à effort par défaut prenait
#                                  # 59,6 s, d'où des « L'analyse IA a expiré » aléatoires.
# DOCUMENT_AI_MAX_OUTPUT_TOKENS=16000
